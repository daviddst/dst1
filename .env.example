LIVEKIT_API_SECRET=CHANGE_ME

# Gemini
GOOGLE_API_KEY=CHANGE_ME

# Agent
AGENT_NAME=DST1
DST1_TEXT_MEMORY_MAX_TURNS=12
DST1_TEXT_MEMORY_TTL_SECONDS=3600

# Whisper
