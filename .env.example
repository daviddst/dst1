# DST1 - exemple uniquement
# Ne jamais mettre de valeurs reelles dans Git.

TZ=Europe/Paris
GENERIC_TIMEZONE=Europe/Paris

# PostgreSQL
DST1_DB_POSTGRESDB_HOST=dst1-postgres
DST1_POSTGRES_USER=CHANGE_ME
DST1_POSTGRES_PASSWORD=CHANGE_ME
DST1_POSTGRES_MULTIPLE_DATABASES=n8n,dst1_agent

# n8n
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_WEBHOOK_BASE=http://dst1-n8n:5678/webhook
WEBHOOK_URL=https://CHANGE_ME
N8N_API_KEY=CHANGE_ME
N8N_API_BASE=http://dst1-n8n:5678/api/v1
