# DST1 - exemple uniquement
# Ne jamais mettre de valeurs reelles dans Git.

TZ=Europe/Paris
GENERIC_TIMEZONE=Europe/Paris

# PostgreSQL
DST1_DB_POSTGRESDB_HOST=dst1-postgres
DST1_POSTGRES_USER=CHANGE_ME
DST1_POSTGRES_PASSWORD=CHANGE_ME
DST1_POSTGRES_MULTIPLE_DATABASES=n8n,dst1_agent

# n8n
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_WEBHOOK_BASE=http://dst1-n8n:5678/webhook
WEBHOOK_URL=https://CHANGE_ME
N8N_API_KEY=CHANGE_ME
N8N_API_BASE=http://dst1-n8n:5678/api/v1
DST1_TOOL_TAG=dst1-tool
GAIA_ROOTURL=https://CHANGE_ME
GAIA_APIKEY=CHANGE_ME
GAIA_MODEL=CHANGE_ME

# WFBuilder : identifiants propres à chaque instance n8n (aucune valeur de
# repli dans les workflows). Requiert N8N_BLOCK_ENV_ACCESS_IN_NODE=false,
# N8N_API_BASE, N8N_API_KEY, WEBHOOK_URL et GAIA_* ci-dessus.
# Data Tables : wf_copilot_sessions (sessions) et audit_log (audit WF9).
# Les workflows WFBuilder sont liés entre eux par leur nom (aucun ID requis).
WFBUILDER_SESSION_TABLE_ID=
WFBUILDER_AUDIT_TABLE_ID=

# WhatsApp
WA_GROUP_BOT_HOME=CHANGE_ME
WA_GROUP_BOT_DAVID=CHANGE_ME

# LiveKit
LIVEKIT_URL=wss://CHANGE_ME.livekit.cloud
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# Gemini
GOOGLE_API_KEY=CHANGE_ME

# Agent
AGENT_NAME=DST1
DST1_TEXT_MEMORY_MAX_TURNS=12
DST1_TEXT_MEMORY_TTL_SECONDS=3600

# Whisper
WHISPER_BASEURL=http://whisper:8000/v1/audio/transcriptions

# Evolution API
EVOLUTION_API_KEY=CHANGE_ME
EVOLUTION_POSTGRES_USER=CHANGE_ME
EVOLUTION_POSTGRES_PASSWORD=CHANGE_ME
EVOLUTION_POSTGRES_DB=evolution_db
EVOLUTION_INSTANCE=CHANGE_ME
EVOLUTION_BASEURL=http://evolution-api:8080

# CallMeBot
CALLMEBOT_API_KEY=CHANGE_ME
CALLMEBOT_URL=https://api.callmebot.com/whatsapp.php
