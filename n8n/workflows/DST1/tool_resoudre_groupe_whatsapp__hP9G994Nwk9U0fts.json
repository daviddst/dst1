        -432,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst groupName = String(body.group_name ?? '').trim();\nif (!groupName) {\n  return [{ json: { error: true, message: \"Le parametre 'group_name' est obligatoire.\" } }];\n}\nreturn [{ json: { ...$json, group_name: groupName } }];"
      },
