          "cachedResultName": "whatsapp_ group_name",
          "cachedResultUrl": "/projects/YlPTF7Aota3PzMSC/datatables/VvTklXsTyzaCUEDz"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "group_name",
              "keyValue": "={{ $('Valider le nom du groupe').first().json.group_name }}"
            }
          ]
        }
      },
      "id": "e9133da9-cbcc-49f2-ad32-e7bfa0c06a5f",
      "name": "Rechercher le groupe dans la Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        256,
        80
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const input = $('Valider le nom du groupe').first().json;\nconst groupName = input.group_name;\n\nconst matches = $input.all()\n  .map((item) => item.json ?? {})\n  .filter((row) => String(row.remoteJid ?? '').trim() !== '');\n\nif (matches.length === 0) {\n  return [{ json: { error: true, message: `Aucune association n'a ete trouvee pour le groupe \"${groupName}\" dans la Data Table whatsapp_group_name. Ajoutez une ligne avec les champs group_name et remoteJid.` } }];\n}\n\nconst row = matches[0];\nconst remoteJid = String(row.remoteJid).trim();\n\nif (!remoteJid.endsWith('@g.us')) {\n  return [{ json: { error: true, message: `Le remoteJid enregistre pour \"${groupName}\" est invalide : \"${remoteJid}\". Un identifiant de groupe WhatsApp doit se terminer par @g.us.` } }];\n}\n\nreturn [{ json: { success: true, group_name: groupName, remoteJid, recipient: remoteJid, message: `Groupe '${groupName}' resolu avec succes.`, duplicate_group_count: matches.length } }];"
      },
