            {
              "id": "e644bf55-e510-49ea-89d9-18f4075d648a",
              "name": "tool_description",
              "type": "string",
              "value": "Resout le nom d'un groupe WhatsApp en son identifiant remoteJid, a partir de la Data Table n8n locale whatsapp_group_name. Utilise cet outil avant l'envoi d'un message dans un groupe WhatsApp. Le resultat remoteJid doit etre transmis a l'outil envoyer_message_whatsapp. Cet outil est en lecture seule."
            },
            {
              "id": "29bb6dc3-a621-4d87-bbfb-e813e9d8dd0a",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"group_name\":{\"type\":\"string\",\"description\":\"Nom exact du groupe WhatsApp, tel qu'enregistre dans la colonne group_name de la Data Table n8n whatsapp_group_name.\"}},\"required\":[\"group_name\"],\"additionalProperties\":false}"
            },
            {
              "id": "569359be-9d17-405c-af15-b0cbe2b52d82",
              "name": "require_confirmation",
              "type": "string",
              "value": "false"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "e75f6208-cdce-4a71-8c8e-51f625cb6fb1",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
