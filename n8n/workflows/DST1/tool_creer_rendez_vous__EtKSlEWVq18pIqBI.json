      "name": "Webhook - Creer RDV",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -544,
        -16
      ],
      "webhookId": "dst1-creer-rdv"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "tool_name",
              "type": "string",
              "value": "creer_rdv"
            },
            {
              "id": "2",
              "name": "tool_description",
              "type": "string",
              "value": "Cree un rendez-vous Google Calendar. Recoit un calendar_id obtenu via resoudre_calendrier; sans calendar_id, utilise primary. Demande confirmation avant appel. Les rappels sont une liste de minutes avant l'evenement."
            },
            {
              "id": "3",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"titre\":{\"type\":\"string\"},\"date_debut\":{\"type\":\"string\",\"description\":\"Date/heure ISO 8601.\"},\"date_fin\":{\"type\":\"string\",\"description\":\"Date/heure ISO 8601. Defaut: une heure apres date_debut.\"},\"lieu\":{\"type\":\"string\"},\"calendar_id\":{\"type\":\"string\",\"description\":\"Identifiant issu de resoudre_calendrier. Defaut: primary.\"},\"rappels_minutes\":{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}},\"required\":[\"titre\",\"date_debut\"],\"additionalProperties\":false}"
            },
            {
              "id": "4",
              "name": "require_confirmation",
              "type": "string",
              "value": "true"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "3ea6b07d-ce5d-4ba0-98f3-3f8bccfdb934",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -320,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json.body||$json;if(!String(x.titre||'').trim()||!x.date_debut)return [{json:{error:true,message:\"titre et date_debut sont obligatoires.\"}}];const start=new Date(x.date_debut);if(Number.isNaN(start.getTime()))return [{json:{error:true,message:\"date_debut est invalide.\"}}];const end=x.date_fin?new Date(x.date_fin):new Date(start.getTime()+3600000);if(Number.isNaN(end.getTime())||end<=start)return [{json:{error:true,message:\"date_fin est invalide ou anterieure au debut.\"}}];const reminders=x.rappels_minutes;if(reminders!==undefined&&(!Array.isArray(reminders)||reminders.some(m=>!Number.isInteger(m)||m<0)))return [{json:{error:true,message:\"rappels_minutes doit etre une liste d'entiers positifs ou nuls.\"}}];return [{json:{calendar_id:x.calendar_id||'primary',titre:String(x.titre).trim(),date_debut:start.toISOString(),date_fin:end.toISOString(),lieu:x.lieu||'',rappels_minutes:reminders}}];"
      },
      "id": "ee515cb6-9e4a-4333-aa43-0ce0ffa1a780",
      "name": "Valider rendez-vous",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        -16
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.error}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "28ec2ef6-24bb-40a0-a4bc-abb71d63179e",
      "name": "Erreur de validation ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        112,
        -16
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": $json.message } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "a6ccf21c-0366-43dc-afc7-11fec085d4a4",
      "name": "Reponse erreur validation",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        320,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/calendar/v3/calendars/{{$json.calendar_id}}/events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ summary: $json.titre, location: $json.lieu, start: { dateTime: $json.date_debut }, end: { dateTime: $json.date_fin }, reminders: $json.rappels_minutes !== undefined ? { useDefault: false, overrides: $json.rappels_minutes.map(m => ({ method: 'popup', minutes: m })) } : { useDefault: true } }) }}",
        "options": {}
      },
      "id": "424d8234-317d-4a20-bce2-c354798a8cc8",
      "name": "Google - Creer evenement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        80
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "eCTasy50Xtp0gc2Y",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const e=$json;const c=$('Valider rendez-vous').first().json;return [{json:{success:true,message:`Rendez-vous \"${c.titre}\" cree.`,event_id:e.id,calendar_id:c.calendar_id,lien:e.htmlLink||null}}];"
      },
      "id": "b6a196fb-9e08-42c9-a94e-620bdfd18714",
      "name": "Retour creation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
