    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((item) => item.json || {}).filter((row) => String(row.remoteJid || '').trim());\nif (rows.length !== 1) throw new Error(`Groupe MyBot Home introuvable ou ambigu dans whatsapp_group_name (${rows.length} résultat(s)).`);\nconst recipient = String(rows[0].remoteJid).trim();\nif (!recipient.endsWith('@g.us')) throw new Error('Le remoteJid de MyBot Home n’est pas un identifiant de groupe valide.');\nconst text = $('Préparer le message').first().json.text;\nreturn [{ json: { recipient, text, delay: 0 } }];"
      },
