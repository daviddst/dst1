    {
      "parameters": {
        "jsCode": "const timeZone = 'Europe/Paris';\nconst now = new Date();\nconst parts = new Intl.DateTimeFormat('en-US', { timeZone, weekday: 'long', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(now);\nconst part = (name) => parts.find((value) => value.type === name).value;\nconst weekday = part('weekday');\nlet text;\nif (weekday === 'Monday') text = '🟤 *Sortir le bac marron (végétaux)*';\nelse if (weekday === 'Thursday') text = '🟢 *Sortir le bac vert (déchets)*';\nelse if (weekday === 'Wednesday') {\n  const date = `${part('year')}-${part('month')}-${part('day')}`;\n  const current = Date.UTC(Number(date.slice(0, 4)), Number(date.slice(5, 7)) - 1, Number(date.slice(8, 10)));\n  const anchor = Date.UTC(2026, 9, 7);\n  const daysSinceAnchor = Math.floor((current - anchor) / 86400000);\n  if (daysSinceAnchor < 0 || daysSinceAnchor % 14 !== 0) return [];\n  text = '🟡 *Sortir le bac jaune (recyclage)*';\n} else return [];\nreturn [{ json: { text } }];"
      },
      "id": "c1cb64c3-535d-42bb-8888-5ca6d2f07739",
      "name": "Choisir le rappel du jour",
