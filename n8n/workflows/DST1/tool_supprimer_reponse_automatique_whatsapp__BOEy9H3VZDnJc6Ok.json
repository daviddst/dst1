        "assignments": {
          "assignments": [
            {
              "id": "e2a91b5c-3a7d-4f8b-9c52-210000000002",
              "name": "tool_name",
              "type": "string",
              "value": "supprimer_reponse_automatique_whatsapp"
            },
            {
              "id": "e2a91b5c-3a7d-4f8b-9c52-210000000003",
              "name": "tool_description",
              "type": "string",
              "value": "Desactive une reponse automatique WhatsApp pour un contact. La regle est conservee dans la Data Table mais son etat devient inactif. Utilise cet outil lorsque l'utilisateur demande de supprimer, desactiver ou arreter une reponse automatique WhatsApp."
            },
            {
              "id": "e2a91b5c-3a7d-4f8b-9c52-210000000004",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"numero\":{\"type\":\"string\",\"description\":\"Numero WhatsApp du contact a desactiver. Formats acceptes : 0609414700, +33609414700, 33609414700.\"}},\"required\":[\"numero\"],\"additionalProperties\":false}"
            },
            {
              "id": "e2a91b5c-3a7d-4f8b-9c52-210000000005",
              "name": "require_confirmation",
              "type": "string",
              "value": "true"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "e95a2762-62d8-4941-af1f-28a00ff4db8f",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1072,
        176
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst rawNumero = String(body.numero ?? '').trim();\n\nif (!rawNumero) {\n  return [{\n    json: {\n      validation_error: \"Le parametre 'numero' est obligatoire.\"\n    }\n  }];\n}\n\nlet numero = rawNumero.replace(/\\D/g, '');\n\nif (numero.startsWith('00')) {\n  numero = numero.slice(2);\n}\n\nif (/^0\\d{9}$/.test(numero)) {\n  numero = `33${numero.slice(1)}`;\n}\n\nif (!/^[1-9]\\d{7,14}$/.test(numero)) {\n  return [{\n    json: {\n      validation_error: `Numero WhatsApp invalide apres normalisation : \"${rawNumero}\". Exemple attendu : 33609414700.`\n    }\n  }];\n}\n\n/*\n * Important : autoMapInputData est utilise dans le node Data Table.\n * Retourner uniquement les colonnes existantes dans whatsapp_reponses_auto.\n */\nreturn [{\n  json: {\n    numero,\n    actif: false\n  }\n}];"
      },
      "id": "34b9a85a-7c1d-4358-bd59-ef4dcfbba36f",
      "name": "Valider et normaliser le numéro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -832,
        176
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "e2a91b5c-3a7d-4f8b-9c52-210000000008",
              "leftValue": "={{ Boolean($json.validation_error) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "45a8aa0f-37d2-4644-ad41-8dc2bfd62f8a",
