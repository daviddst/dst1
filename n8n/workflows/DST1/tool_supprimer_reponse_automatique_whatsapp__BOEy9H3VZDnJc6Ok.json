      "parameters": {
        "jsCode": "const input = $('Valider et normaliser le numéro').first().json;\n\nreturn [{\n  json: {\n    success: true,\n    numero: input.numero,\n    actif: false,\n    message: `Reponse automatique WhatsApp desactivee pour ${input.numero}.`\n  }\n}];"
