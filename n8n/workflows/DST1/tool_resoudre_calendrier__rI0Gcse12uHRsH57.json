      "name": "Webhook - Resoudre Calendrier",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1088,
        128
      ],
      "webhookId": "dst1-resoudre-calendrier"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "tool_name",
              "type": "string",
              "value": "resoudre_calendrier"
            },
            {
              "id": "2",
              "name": "tool_description",
              "type": "string",
              "value": "Resout un nom de calendrier Google Calendar en calendar_id. Utilise cet outil avant consulter_agenda, creer_rdv, modifier_rdv ou supprimer_rdv lorsqu'un calendrier est designe par son nom. Sans calendar_nom, retourne le calendrier principal (primary)."
            },
            {
              "id": "3",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"calendar_nom\":{\"type\":\"string\",\"description\":\"Nom du calendrier a resoudre. Si absent, le calendrier principal est utilise.\"}},\"additionalProperties\":false}"
            },
            {
              "id": "4",
              "name": "require_confirmation",
              "type": "string",
              "value": "false"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "d94b19df-afcf-4080-894d-cdd452d08ecd",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -864,
        128
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/calendar/v3/users/me/calendarList",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {}
      },
      "id": "56ddaa81-3a85-4841-9354-9d4a8d42cad1",
      "name": "Google - Lister calendriers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -640,
        128
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "eCTasy50Xtp0gc2Y",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const bodySrc = $('ToolSchema').first().json.body || $('ToolSchema').first().json;\nconst requested = String(bodySrc.calendar_nom ?? '').trim();\nif (!requested) return [{json:{success:true, calendar_id:'primary', calendar_nom:null, nom_resolu:'Calendrier principal'}}];\nconst target = requested.toLocaleLowerCase();\nconst calendars = $json.items || [];\nconst exact = calendars.find(c => String(c.summary || '').trim().toLocaleLowerCase() === target);\nconst found = exact || calendars.find(c => String(c.summary || '').trim().toLocaleLowerCase().includes(target));\nif (!found) return [{json:{error:true, message:`Aucun calendrier ne correspond a \"${requested}\". Utilise l'outil lister_calendriers.`}}];\nreturn [{json:{success:true, calendar_id:found.id, calendar_nom:requested, nom_resolu:found.summary, principal:!!found.primary, role_acces:found.accessRole}}];"
      },
      "id": "723ccac2-bc1b-442b-a716-3e46d65094c9",
      "name": "Resoudre le calendrier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.error}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
