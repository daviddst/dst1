    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c0e804bd-306f-455c-a605-f913e54a1db9",
              "name": "tool_name",
              "type": "string",
              "value": "envoyer_message_whatsapp"
            },
            {
              "id": "3c29e461-2b78-41cc-a948-061f477eeb4d",
              "name": "tool_description",
              "type": "string",
              "value": "Envoie un message texte WhatsApp via Evolution API a un contact ou a un groupe. Pour un contact, fournir son numero de telephone (format francais ou international). Pour un groupe, fournir le remoteJid retourne par l'outil resoudre_groupe_whatsapp. Utilise cet outil uniquement apres confirmation explicite de l'utilisateur."
            },
            {
              "id": "15b02a67-a721-4056-b321-ece9801c3fd3",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"recipient\":{\"type\":\"string\",\"description\":\"Destinataire WhatsApp. Pour un contact : numero francais ou international, par exemple 0609414700, +33609414700 ou 33609414700. Pour un groupe : remoteJid se terminant par @g.us, fourni par resoudre_groupe_whatsapp.\"},\"text\":{\"type\":\"string\",\"description\":\"Texte du message WhatsApp a envoyer.\"},\"delay\":{\"type\":\"integer\",\"description\":\"Delai avant envoi en millisecondes. Utiliser 0 par defaut.\",\"default\":0}},\"required\":[\"recipient\",\"text\"],\"additionalProperties\":false}"
            },
            {
              "id": "bc9b7eb3-12b9-41a3-a994-74d6517571be",
              "name": "require_confirmation",
              "type": "string",
              "value": "true"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "c0ac1fe2-5880-4c25-9a68-f939c4f45750",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -704,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const rawRecipient = String($json.recipient ?? '').trim();\nconst text = String($json.text ?? '').trim();\nconst delay = Number($json.delay ?? 0);\n\nif (!rawRecipient) {\n  return [{ json: { error: true, message: \"Le parametre 'recipient' est obligatoire.\" } }];\n}\nif (!text) {\n  return [{ json: { error: true, message: \"Le parametre 'text' est obligatoire et ne peut pas etre vide.\" } }];\n}\nif (!Number.isInteger(delay) || delay < 0) {\n  return [{ json: { error: true, message: \"Le parametre 'delay' doit etre un entier positif ou egal a 0.\" } }];\n}\n\nlet recipient;\nlet recipientType;\n\nif (rawRecipient.endsWith('@g.us')) {\n  recipient = rawRecipient;\n  recipientType = 'group';\n} else {\n  recipient = rawRecipient.replace(/\\D/g, '');\n  if (recipient.startsWith('00')) { recipient = recipient.slice(2); }\n  if (/^0\\d{9}$/.test(recipient)) { recipient = `33${recipient.slice(1)}`; }\n  if (!/^[1-9]\\d{7,14}$/.test(recipient)) {\n    return [{ json: { error: true, message: `Numero WhatsApp invalide apres normalisation : \"${rawRecipient}\". Exemple valide : 33609414700.` } }];\n  }\n  recipientType = 'contact';\n}\n\nreturn [{ json: { ...$json, recipient_original: rawRecipient, recipient, recipient_type: recipientType, text, delay } }];"
      },
      "id": "ab19c3f2-bab8-49c5-8602-2a80c2390d1f",
      "name": "Valider et normaliser le destinataire",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
        128
      ]
    },
