              "id": "1",
              "name": "tool_name",
              "type": "string",
              "value": "envoyer_email"
            },
            {
              "id": "2",
              "name": "tool_description",
              "type": "string",
              "value": "Envoie un e-mail en texte brut via Gmail à un seul destinataire. Avant tout appel, présente à l'utilisateur l'adresse du destinataire, l'objet et le texte intégral du message, puis attends sa confirmation explicite. N'appelle cet outil qu'après son accord; en cas de refus ou de doute, n'envoie rien."
            },
            {
              "id": "3",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"to\":{\"type\":\"string\",\"description\":\"Adresse e-mail unique du destinataire.\"},\"subject\":{\"type\":\"string\",\"description\":\"Objet de l'e-mail.\"},\"body\":{\"type\":\"string\",\"description\":\"Corps du message en texte brut.\"}},\"required\":[\"to\",\"subject\",\"body\"],\"additionalProperties\":false}"
            },
            {
              "id": "4",
              "name": "require_confirmation",
              "type": "string",
              "value": "true"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "d27e8b2d-0d2c-479a-a849-5797c912a390",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-496, 320]
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body || $json;\nconst to = String(input.to || '').trim();\nconst subject = String(input.subject || '').trim();\nconst body = typeof input.body === 'string' ? input.body : '';\n\nif (!/^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$/.test(to)) {\n  return [{ json: { error: true, message: \"'to' doit contenir une adresse e-mail valide unique.\" } }];\n}\nif (!subject || /[\\r\\n]/.test(subject)) {\n  return [{ json: { error: true, message: \"'subject' est obligatoire et ne doit pas contenir de retour à la ligne.\" } }];\n}\nif (!body.trim()) {\n  return [{ json: { error: true, message: \"'body' est obligatoire et ne peut pas être vide.\" } }];\n}\n\nreturn [{ json: { to, subject, body } }];"
      },
      "id": "73fe24f0-5904-4018-86c8-e67c38b981d8",
      "name": "Valider les champs",
