    {
      "parameters": {
        "url": "=https://www.googleapis.com/calendar/v3/calendars/{{$json.calendar_id}}/events/{{$json.event_id}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {}
      },
      "id": "9b804e06-c44e-4623-beb0-b7346c46e735",
      "name": "Google - Lire événement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        528,
        64
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "eCTasy50Xtp0gc2Y",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const c=$('Valider paramètres').first().json;const current=($json.reminders&&$json.reminders.overrides)||[];const mins=current.map(x=>x.minutes);if(c.action==='lister')return [{json:{direct:true,success:true,message:mins.length?`Rappels : ${mins.join(', ')} minute(s) avant.`:'Aucun rappel personnalisé.',event_id:c.event_id,calendar_id:c.calendar_id,rappels_minutes:mins}}];if(c.action==='ajouter'){if(mins.includes(c.minutes_avant))return [{json:{direct:true,success:true,message:`Le rappel de ${c.minutes_avant} minutes existe déjà.`,event_id:c.event_id,calendar_id:c.calendar_id,rappels_minutes:mins}}];return [{json:{direct:false,event_id:c.event_id,calendar_id:c.calendar_id,message:`Rappel de ${c.minutes_avant} minute(s) ajouté.`,patch:{reminders:{useDefault:false,overrides:[...current,{method:'popup',minutes:c.minutes_avant}]}}}}];}const kept=current.filter(x=>x.minutes!==c.minutes_avant);if(kept.length===current.length)return [{json:{error:true,message:`Aucun rappel de ${c.minutes_avant} minutes n'existe.`}}];return [{json:{direct:false,event_id:c.event_id,calendar_id:c.calendar_id,message:`Rappel de ${c.minutes_avant} minute(s) supprimé.`,patch:{reminders:kept.length?{useDefault:false,overrides:kept}:{useDefault:true}}}}];"
      },
      "id": "ffafdad5-9871-4115-b9fb-385113902e18",
