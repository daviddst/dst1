    {
      "parameters": {
        "jsCode": "const e=$json;const c=$('Préparer rappels').first().json;return [{json:{success:true,message:c.message,event_id:c.event_id,calendar_id:c.calendar_id,rappels_minutes:((e.reminders&&e.reminders.overrides)||[]).map(x=>x.minutes)}}];"
