    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "tool_name",
              "type": "string",
              "value": "gerer_rappels_rdv"
            },
            {
              "id": "2",
              "name": "tool_description",
              "type": "string",
              "value": "Liste, ajoute ou supprime un rappel d'un rendez-vous Google Calendar sans modifier son titre, ses horaires ou son lieu. Requiert event_id et idéalement calendar_id issus de consulter_agenda. action=lister ne modifie rien; ajouter et supprimer requièrent une confirmation explicite."
            },
            {
              "id": "3",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"event_id\":{\"type\":\"string\"},\"calendar_id\":{\"type\":\"string\",\"description\":\"Identifiant issu de consulter_agenda; défaut primary.\"},\"action\":{\"type\":\"string\",\"enum\":[\"lister\",\"ajouter\",\"supprimer\"]},\"minutes_avant\":{\"type\":\"integer\",\"description\":\"Obligatoire pour ajouter ou supprimer.\"}},\"required\":[\"event_id\",\"action\"],\"additionalProperties\":false}"
            },
            {
              "id": "4",
              "name": "require_confirmation",
              "type": "string",
              "value": "true"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "1ab46c50-bf77-429d-9fd0-9603ea90f1cc",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -112,
        -32
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json.body||$json;if(!String(x.event_id||'').trim())return [{json:{error:true,message:\"event_id est obligatoire.\"}}];if(!['lister','ajouter','supprimer'].includes(x.action))return [{json:{error:true,message:\"action doit être lister, ajouter ou supprimer.\"}}];if(['ajouter','supprimer'].includes(x.action)&&(!Number.isInteger(x.minutes_avant)||x.minutes_avant<0))return [{json:{error:true,message:\"minutes_avant doit être un entier positif ou nul.\"}}];return [{json:{event_id:String(x.event_id).trim(),calendar_id:x.calendar_id||'primary',action:x.action,minutes_avant:x.minutes_avant}}];"
      },
      "id": "cd800bc4-03f4-49d1-ae96-619cf4d878c3",
      "name": "Valider paramètres",
      "type": "n8n-nodes-base.code",
