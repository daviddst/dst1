      "id": "2ae9a65e-08ee-4cad-8263-4ff6980839f8",
      "name": "Reponse erreur validation",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        256,
        208
      ]
    },
    {
      "parameters": {
        "url": "https://people.googleapis.com/v1/people:searchContacts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleContactsOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.query }}"
            },
            {
              "name": "readMask",
              "value": "names,emailAddresses,phoneNumbers,addresses,organizations,biographies,urls"
            },
            {
              "name": "sources",
              "value": "READ_SOURCE_TYPE_CONTACT"
            },
            {
              "name": "pageSize",
              "value": "={{ $json.max_results }}"
            }
          ]
        },
        "options": {}
      },
      "id": "68b0c6dc-4327-4377-abfc-9f0cdc2a9ad1",
      "name": "Rechercher dans Google Contacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        256,
        416
      ],
      "credentials": {
        "googleContactsOAuth2Api": {
          "id": "ia7ANu6QPm7y1tit",
          "name": "Google Contacts david@xinus.net"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $('Valider la recherche').first().json;\nconst response = $json;\nconst results = Array.isArray(response.results) ? response.results : [];\n\nconst valueList = (values, key) => {\n  key = key || 'value';\n  if (!Array.isArray(values)) return [];\n  return values\n    .map((entry) => entry ? entry[key] : undefined)\n    .filter((value) => value !== undefined && value !== null && String(value).trim() !== '')\n    .map((value) => String(value));\n};\n\nconst contacts = results.map((result) => {\n  const person = result.person || {};\n  const names = person.names || [];\n  const primaryName = names[0] || {};\n\n  const addressesRaw = person.addresses || [];\n  const addresses = addressesRaw.map((address) => ({\n    label: address.type || address.formattedType || null,\n    formatted: address.formattedValue || address.streetAddress || null\n  })).filter((address) => address.formatted);\n\n  const organizationsRaw = person.organizations || [];\n  const organizations = organizationsRaw.map((organization) => ({\n    name: organization.name || null,\n    title: organization.title || null\n  })).filter((organization) => organization.name || organization.title);\n\n  return {\n    resource_name: person.resourceName || null,\n    display_name: primaryName.displayName || null,\n    first_name: primaryName.givenName || null,\n    last_name: primaryName.familyName || null,\n    emails: valueList(person.emailAddresses),\n    phones: valueList(person.phoneNumbers),\n    addresses,\n    organizations,\n    biographies: valueList(person.biographies, 'value'),\n    urls: valueList(person.urls)\n  };\n});\n\nreturn [{\n  json: {\n    success: true,\n    query: input.query,\n    result_count: contacts.length,\n    contacts\n  }\n}];"
      },
