              "value": "rechercher_contacts_google"
            },
            {
              "id": "0a440c1b-a6a6-47b9-85e8-91e39bfcdbb3",
              "name": "tool_description",
              "type": "string",
              "value": "Recherche des informations dans les contacts Google auxquels le compte connecte a acces. Utilise cet outil lorsqu'il faut retrouver les coordonnees d'une personne : nom, prenom, adresse e-mail, numero de telephone, adresse postale ou organisation. Fournis une requete aussi precise que possible. Cet outil est en lecture seule."
            },
            {
              "id": "d91891d8-4121-46f2-aac2-e2d166df293d",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Texte de recherche dans Google Contacts : nom, prenom, adresse e-mail, numero de telephone, societe ou autre information connue.\"},\"max_results\":{\"type\":\"integer\",\"description\":\"Nombre maximal de contacts a retourner, entre 1 et 30. Utiliser 10 par defaut.\",\"default\":10}},\"required\":[\"query\"],\"additionalProperties\":false}"
            },
            {
              "id": "f7c24bc4-1c1e-4559-bf0a-8ca5e3d1421f",
              "name": "require_confirmation",
              "type": "string",
              "value": "false"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "9e07ecc8-9d0b-4fd7-9434-2646ad54be03",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -400,
        336
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst query = String(body.query ?? '').trim();\nconst maxResultsRaw = Number(body.max_results ?? 10);\n\nif (!query) {\n  return [{ json: { error: true, message: \"Le parametre 'query' est obligatoire.\" } }];\n}\nif (!Number.isInteger(maxResultsRaw) || maxResultsRaw < 1 || maxResultsRaw > 30) {\n  return [{ json: { error: true, message: \"Le parametre 'max_results' doit etre un entier compris entre 1 et 30.\" } }];\n}\n\nreturn [{ json: { ...body, query, max_results: maxResultsRaw } }];"
      },
      "id": "488e07c5-8c9c-4aad-bf85-9014c6062128",
      "name": "Valider la recherche",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
