          "cachedResultUrl": "/projects/YlPTF7Aota3PzMSC/datatables/n5Kf563nO7SENyir"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "numero",
              "keyValue": "={{ $json.numero }}"
            }
