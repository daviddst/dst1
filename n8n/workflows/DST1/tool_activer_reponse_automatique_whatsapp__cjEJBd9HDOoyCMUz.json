    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c9a7716b-e61f-4f40-86c4-492f4c09c002",
              "name": "tool_name",
              "type": "string",
              "value": "activer_reponse_automatique_whatsapp"
            },
            {
              "id": "c9a7716b-e61f-4f40-86c4-492f4c09c003",
              "name": "tool_description",
              "type": "string",
              "value": "Active la reponse automatique WhatsApp pour un contact. Le numero peut etre au format francais ou international, par exemple 0609414700, +33609414700 ou 33609414700. Utilise cet outil lorsque l'utilisateur demande d'activer une reponse automatique WhatsApp pour un numero ou un contact."
            },
            {
              "id": "c9a7716b-e61f-4f40-86c4-492f4c09c004",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"numero\":{\"type\":\"string\",\"description\":\"Numero WhatsApp du contact a activer. Formats acceptes : 0609414700, +33609414700, 33609414700.\"},\"nom_contact\":{\"type\":\"string\",\"description\":\"Nom facultatif du contact, utilise pour identifier lisiblement la regle.\"}},\"required\":[\"numero\"],\"additionalProperties\":false}"
            },
            {
              "id": "c9a7716b-e61f-4f40-86c4-492f4c09c005",
              "name": "require_confirmation",
              "type": "string",
              "value": "true"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "4da1d326-1f3e-40c2-8376-d83000d3b480",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -992,
        64
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst rawNumero = String(body.numero ?? '').trim();\nconst nomContact = String(body.nom_contact ?? '').trim();\n\nif (!rawNumero) {\n  return [{\n    json: {\n      validation_error: \"Le parametre 'numero' est obligatoire.\"\n    }\n  }];\n}\n\nlet numero = rawNumero.replace(/\\D/g, '');\n\nif (numero.startsWith('00')) {\n  numero = numero.slice(2);\n}\n\nif (/^0\\d{9}$/.test(numero)) {\n  numero = `33${numero.slice(1)}`;\n}\n\nif (!/^[1-9]\\d{7,14}$/.test(numero)) {\n  return [{\n    json: {\n      validation_error: `Numero WhatsApp invalide apres normalisation : \"${rawNumero}\". Exemple attendu : 33609414700.`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    numero,\n    nom_contact: nomContact,\n    actif: true\n  }\n}];"
      },
      "id": "dec912d0-0b6b-49e6-bac1-47fef44c0131",
      "name": "Valider et normaliser le numéro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -752,
        64
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c9a7716b-e61f-4f40-86c4-492f4c09c008",
              "leftValue": "={{ Boolean($json.validation_error) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b4ee9d2e-2fbe-446e-8390-5a31109721ea",
      "name": "Erreur de validation ?",
      "type": "n8n-nodes-base.if",
