        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "75347822-28f2-479c-934e-0cea259c3533",
      "name": "Activer dans Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        -272,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $('Valider et normaliser le numéro').first().json;\nconst nomContact = String(input.nom_contact || '').trim();\nconst label = nomContact ? `${nomContact} (${input.numero})` : input.numero;\n\nreturn [{\n  json: {\n    success: true,\n    numero: input.numero,\n    nom_contact: nomContact || null,\n    actif: true,\n    message: `Reponse automatique WhatsApp activee pour ${label}.`\n  }\n}];"
      },
      "id": "a8fac04a-6f7a-4d2a-8b43-b7bdb5d8379e",
