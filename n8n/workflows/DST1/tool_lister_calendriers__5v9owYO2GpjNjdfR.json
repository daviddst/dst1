      "webhookId": "dst1-lister-calendriers"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "tool_name",
              "type": "string",
              "value": "lister_calendriers"
            },
            {
              "id": "2",
              "name": "tool_description",
              "type": "string",
              "value": "Liste tous les calendriers Google Calendar accessibles, avec leur nom, identifiant, statut principal et role d'acces. Utilise cet outil avant de resoudre un nom de calendrier ou si l'utilisateur demande les calendriers disponibles."
            },
            {
              "id": "3",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}"
            },
