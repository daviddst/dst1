              "name": "require_confirmation",
              "type": "string",
              "value": "false"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "e311188b-3ae3-4aa1-b4c9-d0e3e09c48f7",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        -80
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/calendar/v3/users/me/calendarList",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {}
      },
      "id": "f9763e8b-db45-4957-806b-c07c4b581067",
      "name": "Google - Lister calendriers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        544,
        -80
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "eCTasy50Xtp0gc2Y",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $json.items || [];\nconst calendriers = items.map(c => ({ calendar_id: c.id, nom: c.summary, principal: !!c.primary, role_acces: c.accessRole, couleur: c.backgroundColor || null }));\nreturn [{ json: { success: true, nombre_calendriers: calendriers.length, calendriers } }];"
      },
      "id": "35ea6bce-3cd4-4c94-89bc-4e3c643b7fe0",
      "name": "Formater calendriers",
