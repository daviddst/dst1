      "id": "e05b56d7-1de0-4c20-9e39-eb6b33b2283d",
      "name": "Lire Data Table réponses automatiques",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
