    {
      "parameters": {
        "jsCode": "const rows = $input.all()\n  .map(item => item.json || {})\n  .filter(row => String(row.numero || '').trim() !== '');\n\nfunction isActive(value) {\n  // Data Table n8n retourne actuellement actif sous la forme \"1\"\n  if (value === true || value === 1) {\n    return true;\n  }\n\n  const normalized = String(value ?? '')\n    .trim()\n    .toLowerCase();\n\n  return [\n    'true',\n    '1',\n    'yes',\n    'oui',\n    'active',\n    'actif',\n  ].includes(normalized);\n}\n\nconst contacts = rows\n  .filter(row => isActive(row.actif))\n  .map(row => ({\n    numero: String(row.numero).trim(),\n    nom_contact: String(row.nom_contact || '').trim() || null,\n    actif: true,\n  }));\n\nreturn [{\n  json: {\n    success: true,\n    nombre_reponses_actives: contacts.length,\n    contacts,\n    message: contacts.length === 0\n      ? 'Aucune reponse automatique WhatsApp n est activee.'\n      : `${contacts.length} reponse(s) automatique(s) WhatsApp activee(s).`,\n  },\n}];"
      },
      "id": "a271793b-9ec5-46ec-a90e-3205c8640cea",
      "name": "Filtrer réponses actives",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
