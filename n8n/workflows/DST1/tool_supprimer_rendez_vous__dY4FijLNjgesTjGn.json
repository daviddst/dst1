      "typeVersion": 2,
      "position": [
        -784,
        80
      ],
      "webhookId": "dst1-supprimer-rdv"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "tool_name",
              "type": "string",
              "value": "supprimer_rdv"
            },
            {
              "id": "2",
              "name": "tool_description",
              "type": "string",
              "value": "Supprime definitivement un rendez-vous Google Calendar. Requiert event_id et idealement calendar_id issus de consulter_agenda. Action irreversible : demander confirmation explicite avant appel."
            },
            {
              "id": "3",
              "name": "tool_parameters",
              "type": "string",
              "value": "{\"type\":\"object\",\"properties\":{\"event_id\":{\"type\":\"string\"},\"calendar_id\":{\"type\":\"string\",\"description\":\"Identifiant issu de consulter_agenda; defaut primary.\"}},\"required\":[\"event_id\"],\"additionalProperties\":false}"
            },
            {
              "id": "4",
              "name": "require_confirmation",
              "type": "string",
              "value": "true"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "ce7b250f-8d54-4646-b98a-91a06ee154d6",
      "name": "ToolSchema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -560,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json.body||$json;if(!String(x.event_id||'').trim())return [{json:{error:true,message:\"event_id est obligatoire.\"}}];return [{json:{event_id:String(x.event_id).trim(),calendar_id:x.calendar_id||'primary'}}];"
      },
      "id": "9950644f-61fd-4a8b-86a7-eb6f58528c8a",
      "name": "Valider suppression",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.error}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1077b965-4715-4a70-a28b-4848d3dca54a",
      "name": "Erreur de validation ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -128,
        80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": $json.message } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "fc3eb75e-2000-4124-a78c-cb6f6a2aff6a",
      "name": "Reponse erreur validation",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        80,
        -48
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://www.googleapis.com/calendar/v3/calendars/{{$json.calendar_id}}/events/{{$json.event_id}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {}
      },
      "id": "173a700c-7835-4463-bb71-ee9d8ca5f01b",
      "name": "Google - Supprimer evenement",
      "type": "n8n-nodes-base.httpRequest",
