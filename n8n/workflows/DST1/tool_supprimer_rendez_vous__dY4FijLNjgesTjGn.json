      "position": [
        80,
        160
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "eCTasy50Xtp0gc2Y",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const c=$('Valider suppression').first().json;return [{json:{success:true,message:'Rendez-vous supprime.',event_id:c.event_id,calendar_id:c.calendar_id}}];"
      },
